# Local Sentry toggle — set to "true" only when you want to send events to Sentry
SENTRY_ENABLED=true

# If you want to actually send to Sentry, set SENTRY_ENABLED=true and provide DSN
SENTRY_DSN=

# environment label
SENTRY_ENVIRONMENT=development

# Keep traces disabled by default in dev
SENTRY_TRACES_SAMPLE_RATE=0.5

# release (optional in local)
# SENTRY_RELEASE=local-$(git rev-parse --short HEAD 2>/dev/null || echo "dev")


# DB
DATABASE_URL=

# Celery / broker
REDIS_URL=
CELERY_RESULT_BACKEND=