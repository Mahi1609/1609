# ==========================
# Docker Ignore File for NuScop
# ==========================

# 🔒 Environment & secrets
.env
.env.*
!.env.example

# 🧱 Local data & backups
data/
backups/
raw_pages/
*.db
*.sqlite
*.sqlite3

# 🧠 Virtual environments
venv/
.env/
.venv/

# 🗃️ Python cache / build files
__pycache__/
*.pyc
*.pyo
*.pyd
*.egg-info/
build/
dist/

# 🧰 IDE / editor / OS junk
.vscode/
.idea/
.DS_Store
Thumbs.db

# 🧾 Logs
*.log
*.out
*.err
logs/

# 🧪 Test data or notebooks
tests/
notebooks/
*.ipynb

# 🧰 Git & Docker internals
.git/
.gitignore
docker-compose.local.yml
Dockerfile

# 🪶 Temporary files
tmp/
*.tmp
*.bak
